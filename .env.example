# ─────────────────────────────────────────────────────────────────────────────
# regi environment variables. Copy to .env.local for development.
# With NOTHING set, `npm run dev` runs fully local: in-process Postgres (PGlite)
# + dev sign-in (magic link shown on screen). Set the Supabase block to use real auth/DB.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the app (share links, OG tags, auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Needs Mikaela: hosted project) ─────────────────────────────────
# Setting these switches auth to Supabase (Google + email magic link).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for account deletion (auth admin) and storage uploads. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string for server-side queries (Supabase → Project Settings → Database →
# Connection string, "Transaction pooler"). Queries run as role `authenticated` with RLS enforced.
DATABASE_URL=
# Storage bucket for product photos (created by migration 20261028000004)
SUPABASE_STORAGE_BUCKET=product-photos

# ── Auth providers ───────────────────────────────────────────────────────────
# Show the "Continue with Google" button (configure the provider in Supabase → Auth → Providers)
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=true
# Show "Continue with Apple" (optional on web; needs Apple keys in Supabase)
NEXT_PUBLIC_AUTH_APPLE_ENABLED=false
# Only for `supabase start` locally (read by supabase/config.toml)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Production magic-link email: configure SMTP in Supabase → Auth → SMTP Settings (Needs Mikaela)

# ── Web Push (VAPID). Generate with: npm run gen:vapid ─────────────────────
# If unset, push sending is stubbed (logged) and in-app alerts still work.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@regi.app

# ── Scheduled jobs ───────────────────────────────────────────────────────────
# Bearer token required by /api/cron/rollover and /api/cron/notifications
CRON_SECRET=

# ── Local development / tests only (ignored when Supabase is configured) ─────
# Where the local PGlite database lives
REGI_DATA_DIR=.data/pglite
# 1 = wipe the local database on boot (Playwright uses this)
REGI_RESET_DB=0
# Allow dev sign-in on a production build (Playwright runs `next start`)
ALLOW_DEV_AUTH=0
# Secret for signing dev session cookies
DEV_AUTH_SECRET=change-me-dev-only
# 1 = honour the regi_time_offset cookie (lets tests advance the logical day)
ALLOW_TIME_TRAVEL=0
